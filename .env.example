# Base relationnelle (état conversationnel, préférences, mémoire long terme)
DB_URL=postgresql+psycopg://app:app@localhost:5432/velmo

# Agent principal : Azure AI Inference (Mistral-Large-3)
AZURE_AI_INFERENCE_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_INFERENCE_API_KEY=your-azure-ai-inference-key-here
AZURE_AI_INFERENCE_MODEL=Mistral-Large-3

# Juge garde-fous (Chantier 2) : chemin BLOQUANT synchrone (chaque message) —
# déploiement/quota isolé, ne doit jamais partager son budget de rate-limit
# avec les usages asynchrones ci-dessous.
AZURE_OPENAI_GUARD_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_GUARD_API_KEY=your-azure-openai-guard-key-here
AZURE_OPENAI_GUARD_DEPLOYMENT=gpt-5-mini

# Extracteur mémoire (Chantier 1) + juge DeepEval Qualité (Chantier 3) :
# usages ASYNCHRONES/best-effort — peuvent partager un même déploiement.
# claude-opus-4-5 via Azure AI Foundry (AnthropicFoundry), pas l'API Anthropic
# directe — endpoint = ressource Foundry + suffixe /anthropic.
ANTHROPIC_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
ANTHROPIC_API_KEY=your-anthropic-foundry-key-here
# ANTHROPIC_ASYNC_MODEL=claude-opus-4-5  # défaut déjà dans config.py

# Classifieur de modération (garde-fous G1/G2/G3) — Llama Guard 3 via Ollama,
# combiné en OR avec le repli lexical (CombinedClassifier)
OLLAMA_URL=http://localhost:11434
LLAMA_GUARD_MODEL=llama-guard3:8b
# Seuil de latence (ms) au-delà duquel un warning documente le besoin de
# basculer vers le modèle 1B. Pas de bascule automatique.
LLAMA_GUARD_LATENCY_THRESHOLD_MS=800.0

# PII redaction en texte libre : Azure AI Language.
AZURE_LANGUAGE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_LANGUAGE_KEY=your-azure-language-key-here

# Prompt Shields : Azure AI Content Safety.
AZURE_CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=your-azure-content-safety-key-here

# Base vectorielle (KB FAQ, hors mémoire épisodique — migrée vers pgvector)
CHROMA_URL=http://localhost:8001
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Mémoire épisodique : embeddings pgvector (même Postgres que le reste)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# API.
VELMO_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Distingue prod (fail-fast si config LLM absente) de dev/CI (repli EchoLLM toléré).
ENVIRONMENT=development

# Seuil d'écriture mémoire long terme (à calibrer sur eval/memory_confidence_cases.jsonl)
MEMORY_CONFIDENCE_THRESHOLD=0.7

# Tarif €/1000 tokens par modèle — override JSON optionnel (défaut dans config.py).
# TOKEN_PRICING={"gpt-5-mini":0.0015,"Mistral-Large-3":0.003,"claude-opus-4-5":0.01}

# Langfuse self-host (jamais Langfuse Cloud — conversations client = PII).
# Les 3 absentes => get_sink() retombe sur NullSink.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3001
