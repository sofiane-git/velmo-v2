# Base relationnelle (état conversationnel, préférences, mémoire long terme)
DB_URL=postgresql+psycopg://app:app@localhost:5432/velmo

# Repli local (SQLite fichier / store en mémoire) quand Postgres est injoignable.
# Défaut false : en production (ENVIRONMENT=production) un Postgres injoignable
# fait échouer le démarrage plutôt que de dégrader silencieusement (D3-03) ; en
# dev/CI le repli reste toléré quelle que soit cette valeur.
ALLOW_SQLITE_FALLBACK=false

# Credentials Postgres consommés par docker-compose (service `postgres` + DB_URL
# de l'app construite dessus, source unique). Défauts app/app/velmo si absents.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=velmo

# Agent principal : Azure AI Inference (Mistral-Large-3)
AZURE_AI_INFERENCE_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_INFERENCE_API_KEY=your-azure-ai-inference-key-here
AZURE_AI_INFERENCE_MODEL=Mistral-Large-3

# Juge garde-fous (Chantier 2) : chemin BLOQUANT synchrone (chaque message) —
# déploiement/quota isolé, ne doit jamais partager son budget de rate-limit
# avec les usages asynchrones ci-dessous.
# Forme OpenAI-compatible `/openai/v1` OBLIGATOIRE (règle projet : toujours
# préférer cette forme quand le service l'expose) — judge.py utilise le client
# OpenAI standard sur ce base_url ; l'endpoint « nu » (sans /openai/v1) 404.
AZURE_OPENAI_GUARD_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_GUARD_API_KEY=your-azure-openai-guard-key-here
AZURE_OPENAI_GUARD_DEPLOYMENT=gpt-5-mini
# gpt-5-mini refuse `logprobs` (400) : false évite l'aller-retour perdu + le
# warning au premier appel de chaque process (sinon, repli automatique).
AZURE_OPENAI_GUARD_LOGPROBS=false

# Extracteur mémoire (Chantier 1) + juge DeepEval Qualité (Chantier 3) :
# usages ASYNCHRONES/best-effort — peuvent partager un même déploiement.
# claude-opus-4-5 via Azure AI Foundry (AnthropicFoundry), pas l'API Anthropic
# directe — endpoint = ressource Foundry + suffixe /anthropic.
ANTHROPIC_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
ANTHROPIC_API_KEY=your-anthropic-foundry-key-here
# ANTHROPIC_ASYNC_MODEL=claude-opus-4-5  # défaut déjà dans config.py

# Classifieur de modération (garde-fous G1/G2/G3) — Llama Guard 3 via Ollama,
# combiné en OR avec le repli lexical (CombinedClassifier)
OLLAMA_URL=http://localhost:11434
LLAMA_GUARD_MODEL=llama-guard3:8b
# Seuil de latence (ms) au-delà duquel un warning documente le besoin de
# basculer vers le modèle 1B. Pas de bascule automatique.
LLAMA_GUARD_LATENCY_THRESHOLD_MS=800.0

# PII redaction en texte libre : Azure AI Language. SANS /openai/v1 (API propre).
# Raccourci : la ressource AIServices (Foundry) existante sert déjà ce service —
# pointer sa racine cognitiveservices + sa clé, rien à déployer (tuto §11).
AZURE_LANGUAGE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_LANGUAGE_KEY=your-azure-language-key-here

# Prompt Shields : Azure AI Content Safety. SANS /openai/v1 (API propre) —
# même raccourci multi-service que AZURE_LANGUAGE_* (tuto §11).
AZURE_CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=your-azure-content-safety-key-here

# Base vectorielle (KB FAQ, hors mémoire épisodique — migrée vers pgvector).
# Variable unique : CHROMA_URL (lue par velmo.kb_store ET scripts/seed_kb.py).
# 8001 = port hôte mappé par docker-compose (conteneur : 8000).
CHROMA_URL=http://localhost:8001

# Mémoire épisodique : embeddings pgvector (même Postgres que le reste)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# API.
VELMO_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Distingue prod (fail-fast si config LLM absente) de dev/CI (repli EchoLLM toléré).
ENVIRONMENT=development

# Seuil d'écriture mémoire long terme (à calibrer sur eval/memory_confidence_cases.jsonl)
MEMORY_CONFIDENCE_THRESHOLD=0.7

# Budget de tokens de la fenêtre court terme avant compression (R4) — hashé dans
# la version évaluée (memory_config_hash).
MEMORY_TOKEN_BUDGET=2000

# Tarif €/1000 tokens par modèle — override JSON optionnel (défaut dans config.py).
# TOKEN_PRICING={"gpt-5-mini":0.0015,"Mistral-Large-3":0.003,"claude-opus-4-5":0.01}

# Langfuse Cloud, région EU (projet pédagogique — pas de vraies conversations
# client en prod ; self-host resterait la bonne pratique sinon, voir
# deploy/langfuse/README.md). Les 3 absentes => get_sink() retombe sur NullSink.
# Compte + clés : cloud.langfuse.com (EU) → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Seuils du gate qualité MLOps (source unique, hashés dans l'identité de
# version — audit D8-05). Défauts sains dans config.py ; surcharger seulement
# pour calibrer, jamais en dur dans le code.
# GATE_MIN_SCORE=0.80
# GATE_LATENCY_P95_CEILING_MS=4000.0
# GATE_COST_PER_CONV_CEILING=0.05

# Base persistante (baseline de non-régression MLOps, audit B5) — la
# résolution passe par DB_URL (source unique, architecture single-Postgres).
# En CI release/nightly : secret GitHub DB_URL vers le Postgres flexible
# Azure (tuto §3). Absente/injoignable => repli SQLite local (dev uniquement).
# gh secret set DB_URL --body "postgresql+psycopg://velmo_app:...@<serveur>.postgres.database.azure.com:5432/velmo"
