# Copier en deploy/langfuse/.env (gitignored) et remplir — jamais de secret ici.
# Générer des valeurs fortes : openssl rand -hex 32

# Secrets internes Langfuse (noms exacts à relever dans le docker-compose.yml
# cloné au Step 1 — ils peuvent changer de version en version ; ne pas figer
# les noms de variable en dur dans ce dépôt).
# NEXTAUTH_SECRET=<openssl rand -hex 32>
# SALT=<openssl rand -hex 32>
# ENCRYPTION_KEY=<openssl rand -hex 32>
# POSTGRES_PASSWORD=<mot de passe fort>
# CLICKHOUSE_PASSWORD=<mot de passe fort>
# (+ les variables de stockage objet — S3/MinIO — présentes dans leur fichier)

# Provisioning automatique (headless init, langfuse.com/self-hosting/headless-initialization)
# — évite le clickthrough manuel dans l'UI pour créer org/projet/clés API.
LANGFUSE_INIT_ORG_ID=velmo
LANGFUSE_INIT_ORG_NAME="Velmo 2.0"
LANGFUSE_INIT_PROJECT_ID=velmo-mlops
LANGFUSE_INIT_PROJECT_NAME="Velmo MLOps"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=<généré, ex. openssl rand -hex 16 préfixé pk->
LANGFUSE_INIT_PROJECT_SECRET_KEY=<généré, ex. openssl rand -hex 16 préfixé sk->
LANGFUSE_INIT_USER_EMAIL=<email admin local>
